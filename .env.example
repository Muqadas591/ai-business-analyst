# ============================================================
# AI Business Analyst — Environment Variable Template
# ============================================================
# This file contains placeholders only.
# Never place real credentials in this file.

# Application
APP_NAME=AI Business Analyst
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL
# Local development example only.
# Set the real production value in your hosting provider's
# environment/secrets configuration.
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/business_analyst

# Application authentication
# Replace the placeholder with a strong random secret in the
# actual environment. Never use this example value in production.
AUTH_SECRET_KEY=replace_with_a_secure_random_secret
AUTH_ISSUER_URL=

# Central AI configuration
# Confirm how these settings connect to the existing insight
# provider before enabling an external provider.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=

# Upload and dataset limits
MAX_UPLOAD_SIZE_MB=25
MAX_ROWS=100000
MAX_COLUMNS=200
TEMP_FILE_TTL_MINUTES=60

# CSV ingestion
CSV_SAMPLE_BYTES=65536
# Request and response limits
INSIGHT_TIMEOUT_SECONDS=45
INSIGHT_MAX_OUTPUT_TOKENS=2500
INSIGHT_MAX_EVIDENCE_CHARS=24000